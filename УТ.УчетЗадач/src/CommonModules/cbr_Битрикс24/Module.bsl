#Область ПрограммныйИнтерфейс

#Область Задачи
// Проходится по регистру с заданиями на отправку. И если они есть отправляет данные в Битрикс24.
Процедура ОтправкаДанныхВБитрикс24() Экспорт
	
	ДанныеАвторизации = ПолучитьДанныеАвторизации();
	
	Если НЕ ДанныеАвторизации.Битрикс24ИнтеграцияВключена Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	cbr_Б24_ОчередьОтправки.Задача КАК ЗадачаСсылка,
		|	cbr_Б24_ОчередьОтправки.Задача.Представление КАК ЗадачаПредставление,
		|	cbr_Б24_ОчередьОтправки.Действие КАК Действие,
		|	cbr_Б24_ОчередьОтправки.КоличествоДействий КАК КоличествоДействий,
		|	cbr_Б24_ОчередьОтправки.ОшибкаПриОтправке КАК Ошибка,
		|	cbr_Б24_ОчередьОтправки.Приоритет КАК Приоритет,
		|	cbr_Б24_СоответствиеЗадач.АйДиЗадачиБитрикс КАК АйДиЗадачиБитрикс,
		|	cbr_Б24_ОчередьОтправки.КоличествоПопыток КАК КоличествоПопыток
		|ИЗ
		|	РегистрСведений.cbr_Б24_ОчередьОтправки КАК cbr_Б24_ОчередьОтправки
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.cbr_Б24_СоответствиеЗадач КАК cbr_Б24_СоответствиеЗадач
		|		ПО cbr_Б24_ОчередьОтправки.Задача = cbr_Б24_СоответствиеЗадач.Задача
		|ГДЕ
		|	cbr_Б24_ОчередьОтправки.Приоритет > 0
		|
		|УПОРЯДОЧИТЬ ПО
		|	Приоритет
		|ИТОГИ
		|	МАКСИМУМ(АйДиЗадачиБитрикс) КАК АйДиЗадачиБитрикс
		|ПО
		|	ЗадачаСсылка";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаЗадача = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаЗадача.Следующий() Цикл
		
		ЭтоНоваяЗадача = НЕ ЗначениеЗаполнено(ВыборкаЗадача.АйДиЗадачиБитрикс);
		ПервыйЦиклВыборки = Истина;
		ЗадачаБылаОтправлена = Ложь;
		
		Выборка = ВыборкаЗадача.Выбрать();
		Пока Выборка.Следующий() Цикл
			
			СтруктураЗаписи = Новый Структура;
			СтруктураЗаписи.Вставить("Задача", Выборка.ЗадачаСсылка);
			СтруктураЗаписи.Вставить("Действие", Выборка.Действие);
			
			ЗаписьРегистра = РегистрыСведений.cbr_Б24_ОчередьОтправки.СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(ЗаписьРегистра, СтруктураЗаписи);
			ЗаписьРегистра.Прочитать();
			
			Если Выборка.КоличествоПопыток >= Число(ДанныеАвторизации.КоличествоПопыток) Тогда
				
				ДанныеУведомления = ПолучитьСтруктуруУведомления(Выборка, ДанныеАвторизации.Администратор);
				cbr_УведомленияПользователей.ОтправитьУведомлениеПользователю(ДанныеУведомления.СвойстваУведомления,
																		ДанныеУведомления.ПринудительныеУведомления);
				
				ЗаписьРегистра.Приоритет = 0;
				ЗаписьРегистра.Записать();
				Продолжить;
				
			КонецЕсли;
			
			Если ЗадачаБылаОтправлена И Выборка.Приоритет = 3 Тогда
				ЗаписьРегистра.Удалить();
				Продолжить;
			КонецЕсли;
			
			КоличествоДействий = Выборка.КоличествоДействий;
			Ответ = ВыполнитьДействиеДляЗадачи(Выборка.ЗадачаСсылка, 
															Выборка.Действие,
															КоличествоДействий,
															ДанныеАвторизации);
				
			Если Ответ.ДействиеВыполнено И КоличествоДействий = 0 Тогда
				
				Если ПервыйЦиклВыборки Тогда
					ЗадачаБылаОтправлена = Выборка.Приоритет = 1
				КонецЕсли;
				
				ЗаписьРегистра.Удалить();	
			Иначе
				СтруктураЗаписи.Вставить("КоличествоДействий", КоличествоДействий);
				СтруктураЗаписи.Вставить("ОшибкаПриОтправке", Ответ.Результат);
				СтруктураЗаписи.Вставить("Приоритет", Выборка.Приоритет);
				СтруктураЗаписи.Вставить("КоличествоПопыток", ЗаписьРегистра.КоличествоПопыток + 1);
				СтруктураЗаписи.Вставить("ДатаПоследнейПопытки", ТекущаяДатаСеанса());
				
				ЗаполнитьЗначенияСвойств(ЗаписьРегистра, СтруктураЗаписи);
				ЗаписьРегистра.Записать();
				
				Если Выборка.Приоритет = 1 И ЭтоНоваяЗадача Тогда
					Прервать;
				КонецЕсли;
				
			КонецЕсли;
			
			ПервыйЦиклВыборки = Ложь;
			
		КонецЦикла;
		
		ВызватьПаузу(1000);
		
	КонецЦикла;
	
КонецПроцедуры

// Обновляет запись в регистре для очереди действий с Битрикс24.
// 
// Параметры:
//  ЗадачаСсылка 	- ДокументСсылка.cbr_Задача 			- Задача ссылка
//  Триггер 		- ПеречислениеСсылка.cbr_ПодпискаДляТриггера
Процедура ДобавитьДействиеВОчередь(Знач ЗадачаСсылка, Знач Триггер) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ЗадачаСсылка) ИЛИ НЕ ЗначениеЗаполнено(Триггер) Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеАвторизации = ПолучитьДанныеАвторизации();
	
	Если НЕ ДанныеАвторизации.Битрикс24ИнтеграцияВключена Тогда
		Возврат;
	КонецЕсли;
	
	ТипНастройки = Перечисления.cbr_Б24_Настройки.ТриггерСоответствие;
	ДанныеНастройки = РегистрыСведений.cbr_Б24_Настройки.Получить(Новый Структура("ТипНастройки, Настройка", ТипНастройки, Триггер));
	Действие = ДанныеНастройки.Значение;
	
	Если НЕ ЗначениеЗаполнено(Действие) Тогда
		Возврат;
	КонецЕсли;
	
	ПриоритетКомментария = 2;
	Приоритет = ПолучитьПриоритетДействия(Действие);
	
	СтруктураЗаписи = Новый Структура;
	СтруктураЗаписи.Вставить("Задача", ЗадачаСсылка);
	СтруктураЗаписи.Вставить("Действие", Действие);
	СтруктураЗаписи.Вставить("ОшибкаПриОтправке", "");
	СтруктураЗаписи.Вставить("КоличествоПопыток", 0);
	СтруктураЗаписи.Вставить("Приоритет", Приоритет);
	СтруктураЗаписи.Вставить("ДатаПоследнейПопытки", ТекущаяДатаСеанса());
	
	Если Приоритет = ПриоритетКомментария Тогда
		Данные = РегистрыСведений.cbr_Б24_ОчередьОтправки.Получить(Новый Структура("Задача, Действие", ЗадачаСсылка, Действие));
		КоличествоДействий = Данные.КоличествоДействий + 1;
		СтруктураЗаписи.Вставить("КоличествоДействий", КоличествоДействий);
	КонецЕсли;
	
	ОбменДаннымиСлужебный.ОбновитьЗаписьВРегистрСведений(СтруктураЗаписи, "cbr_Б24_ОчередьОтправки");
	
КонецПроцедуры


// Выполнить действие для задачи.
// 
// Параметры:
//  ЗадачаСсылка - ДокументСсылка.cbr_Задача - Ссылка на задачу для которой совершается действие
//  Действие - ПеречислениеСсылка.cbr_Б24_Действия - Действие совершаемое для задачи
//  КоличествоДействий - Число - Количество действий (используется только для комментариев)
//  ДанныеАвторизации - Структура - Данные авторизации полученные из регистра настроек для Битрикс24
// 
// Возвращаемое значение:
//  Структура - результат выполнения действия для задачи:
// * ДействиеВыполнено - Булево - Получилось или нет отправить данные в Битрикс24
// * Результат - Строка - Если не получилось, то тут будет текст ошибки
Функция ВыполнитьДействиеДляЗадачи(Знач ЗадачаСсылка, Знач Действие, КоличествоДействий, Знач ДанныеАвторизации)
	
	Если НЕ ЗначениеЗаполнено(ЗадачаСсылка) ИЛИ НЕ ЗначениеЗаполнено(Действие) Тогда
		Возврат СоздатьСтруктуруРезультатаДействия(Ложь, "Не заполнены нужные реквизиты");
	КонецЕсли;
	
	Если Действие = Перечисления.cbr_Б24_Действия.СменитьСтатусЗадачи Тогда
		Ответ = СменитьСтатусЗадачи(ЗадачаСсылка, ДанныеАвторизации);
		
	ИначеЕсли Действие = Перечисления.cbr_Б24_Действия.ОтправитьЗадачу Тогда
		Ответ = ОтправитьЗадачуВБитрикс(ЗадачаСсылка, ДанныеАвторизации);
		
	ИначеЕсли Действие = Перечисления.cbr_Б24_Действия.СменитьИсполнителяЗадачи Тогда
		Ответ = СменитьИсполнителяЗадачи(ЗадачаСсылка, ДанныеАвторизации);
		
	ИначеЕсли Действие = Перечисления.cbr_Б24_Действия.СменитьДедлайнЗадачи Тогда
		Ответ = СменитьДедлайнЗадачи(ЗадачаСсылка, ДанныеАвторизации);
		
	ИначеЕсли Действие = Перечисления.cbr_Б24_Действия.СменитьОценкуЗадачи Тогда
		Ответ = СменитьОценкуЗадачи(ЗадачаСсылка, ДанныеАвторизации);
	
	ИначеЕсли Действие = Перечисления.cbr_Б24_Действия.ВернутьВышестоящуюЗадачуВРаботу Тогда
		Ответ = ВернутьВышестоящуюЗадачуВРаботу(ЗадачаСсылка, ДанныеАвторизации);
	
	ИначеЕсли Действие = Перечисления.cbr_Б24_Действия.ОтправитьКомментарий Тогда
		Ответ = ДобавитьКомментарийКЗадачеБитрикс(ЗадачаСсылка, КоличествоДействий, ДанныеАвторизации);
		
	ИначеЕсли Действие = Перечисления.cbr_Б24_Действия.ОтправитьКомментарийИзВопроса Тогда
		Ответ = СоздатьКомментарийКЗадачеИзВопроса(ЗадачаСсылка, КоличествоДействий, ДанныеАвторизации);
		
	ИначеЕсли Действие = Перечисления.cbr_Б24_Действия.УдалитьЗадачу Тогда
		Ответ = УдалитьЗадачуВБитриксе(ЗадачаСсылка, ДанныеАвторизации);
			
	Иначе
		Возврат СоздатьСтруктуруРезультатаДействия(Ложь);
	КонецЕсли;
	
	Возврат Ответ;
	
КонецФункции

#КонецОбласти

#Область Сообщения

// Отправить сообщение пользователю в битрикс.
// 
// Параметры:
//  Пользователь - СправочникСсылка.Пользователи - Пользователь которому отправляется сообщение
//  Описание - Строка - Сообщение для пользователя
Процедура ОтправитьСообщениеПользователюВБитрикс(Знач Пользователь, Знач Описание) Экспорт
	
	ДанныеАвторизации = ПолучитьДанныеАвторизации();
	
	Если НЕ ДанныеАвторизации.Битрикс24ИнтеграцияВключена Тогда
		Возврат;
	КонецЕсли;
	
	ЗаписьРегистра = РегистрыСведений.cbr_ПользователиБитрикс.Получить(Новый Структура("Пользователь", Пользователь));
	ИДБитрикс = ЗаписьРегистра.ИДБитрикс;
	
	Если ЗначениеЗаполнено(ИДБитрикс) Тогда
		Ответ = OPI_Bitrix24.ОтправитьСообщение(ДанныеАвторизации.БитриксURL, ИДБитрикс, Описание, , ДанныеАвторизации.Токен);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

#Область ОсновныеФункции

// Отправить задачу в битрикс полностью.
// 
// Параметры:
//  ЗадачаСсылка 		- ДокументСсылка.cbr_Задача - Задача ссылка
//  ДанныеАвторизации 	- Структура
Функция ОтправитьЗадачуВБитрикс(Знач ЗадачаСсылка, Знач ДанныеАвторизации) Экспорт
	
	СтруктураЗадачи = ПолучитьДанныеЗадачи(ЗадачаСсылка);
	ПереработатьДанныеСтруктуры(СтруктураЗадачи);
	
	АйДиЗадачиБитрикс = СтруктураЗадачи.АйДиЗадачиБитрикс;
	
	Ответ = ОтправитьФайлыВБитрикс(СтруктураЗадачи, ДанныеАвторизации);	
	
	Если НЕ Ответ.ДействиеВыполнено Тогда
		Возврат Ответ;
	КонецЕсли;
	
	ОбновитьОписание(СтруктураЗадачи, ДанныеАвторизации);
	
	// Отправка данных задачи в Битрикс24
	СтруктураЗадачиДляБитрикса = СоздатьСтруктуруЗадачиДляБитрикса(СтруктураЗадачи);
	
	Если ЗначениеЗаполнено(АйДиЗадачиБитрикс) Тогда
		Ответ = OPI_Bitrix24.ИзменитьЗадачу(ДанныеАвторизации.БитриксURL, АйДиЗадачиБитрикс, СтруктураЗадачиДляБитрикса, ДанныеАвторизации.Токен);
		ЭтоНоваяЗадача = Ложь;
		
	Иначе
		Ответ = OPI_Bitrix24.СоздатьЗадачу(ДанныеАвторизации.БитриксURL, СтруктураЗадачиДляБитрикса, ДанныеАвторизации.Токен);
		ЭтоНоваяЗадача = Истина;
		
	КонецЕсли;
	
	Если Ответ["error"] <> Неопределено Тогда
		Возврат СоздатьСтруктуруРезультатаДействия(Ложь, Ответ["error_description"]);
	КонецЕсли;
	
	ДанныеЗадачи = Ответ["result"]["task"];
	
	Если ЭтоНоваяЗадача Тогда
		
		АйДиЗадачиБитрикс = ДанныеЗадачи["id"];
		
		СтруктураЗаписи = Новый Структура;
		СтруктураЗаписи.Вставить("Задача", СтруктураЗадачи.ЗадачаСсылка);
		СтруктураЗаписи.Вставить("АйДиЗадачиБитрикс", АйДиЗадачиБитрикс);
		
		Если ЗначениеЗаполнено(СтруктураЗадачи.АйДиПапкиФайлов) Тогда
			СтруктураЗаписи.Вставить("АйДиПапкиФайлов", СтруктураЗадачи.АйДиПапкиФайлов);
		КонецЕсли;
		
		ОбменДаннымиСлужебный.ОбновитьЗаписьВРегистрСведений(СтруктураЗаписи, "cbr_Б24_СоответствиеЗадач");
        
		ТекстПервогоКомментария = СтрШаблон("Задача создана на основании: %1", ПолучитьНавигационнуюСсылку(ЗадачаСсылка));
		
		Ответ = OPI_Bitrix24.ДобавитьКомментарийЗадачи(ДанныеАвторизации.БитриксURL, АйДиЗадачиБитрикс, ТекстПервогоКомментария, ДанныеАвторизации.Токен);
	
	КонецЕсли;
		
	Ответ = ОтправитьЧекЛистВБитрикс(СтруктураЗадачи, ДанныеЗадачи, ДанныеАвторизации);
	
	Если НЕ Ответ.ДействиеВыполнено Тогда
		Возврат Ответ;
	КонецЕсли;
	
	Возврат СоздатьСтруктуруРезультатаДействия(Истина);
	
КонецФункции

// Удалить задачу в битриксе.
// 
// Параметры:
//  ЗадачаСсылка - ДокументСсылка.cbr_Задача - Ссылка на задачу для получения АйДи задачи в Битриксе
Функция УдалитьЗадачуВБитриксе(Знач ЗадачаСсылка, Знач ДанныеАвторизации) Экспорт
	// TODO: Титов - При удалении задачи должна удаляться папка под файлы
	// TODO: Титов - Удалять запись регистра соответствие задач
	// TODO: Титов - ПРОВЕРИТЬ ЛОГИКУ ФУНКЦИИ
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	cbr_Б24_СоответствиеЗадач.АйДиЗадачиБитрикс КАК АйДиЗадачиБитрикс,
		|	cbr_Б24_СоответствиеЗадач.АйДиПапкиФайлов КАК АйДиПапкиФайлов
		|ИЗ
		|	РегистрСведений.cbr_Б24_СоответствиеЗадач КАК cbr_Б24_СоответствиеЗадач
		|ГДЕ
		|	cbr_Б24_СоответствиеЗадач.Задача = &ЗадачаСсылка";
	
	Запрос.УстановитьПараметр("ЗадачаСсылка", ЗадачаСсылка);
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат "Заглушка";
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если ЗначениеЗаполнено(Выборка.АйДиЗадачиБитрикс) Тогда

			Ответ = OPI_Bitrix24.УдалитьЗадачу(ДанныеАвторизации.БитриксURL, Выборка.АйДиЗадачиБитрикс, ДанныеАвторизации.Токен);
		
			Если Ответ["error"] <> Неопределено Тогда
				Возврат СоздатьСтруктуруРезультатаДействия(Ложь, Ответ["error_description"]);
			КонецЕсли;
		
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Выборка.АйДиЗадачиБитрикс) Тогда	
			
			Ответ = OPI_Bitrix24.УдалитьКаталог(ДанныеАвторизации.БитриксURL, Выборка.АйДиПапкиФайлов, ДанныеАвторизации.Токен);
			
			Если Ответ["error"] <> Неопределено Тогда
				
				СтруктураЗаписи = Новый Структура;
				СтруктураЗаписи.Вставить("Задача", ЗадачаСсылка);
				СтруктураЗаписи.Вставить("АйДиПапкиФайлов", Выборка.АйДиПапкиФайлов);
				
				ОбменДаннымиСлужебный.ОбновитьЗаписьВРегистрСведений(СтруктураЗаписи, "cbr_Б24_СоответствиеФайлов");
				Возврат СоздатьСтруктуруРезультатаДействия(Ложь, Ответ["error_description"]);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ОбменДаннымиСлужебный.УдалитьНаборЗаписейВРегистреСведений(Новый Структура("Задача", ЗадачаСсылка), "cbr_Б24_СоответствиеЗадач");
	
	Возврат "Заглушка";
	
КонецФункции

Функция СменитьСтатусЗадачи(Знач ЗадачаСсылка, Знач ДанныеАвторизации) Экспорт
	
	СтатусВБитриксеСтандартный = 2;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ЕСТЬNULL(cbr_Б24_Настройки.Значение, &СтатусВБитриксеСтандартный) КАК STATUS,
		|	cbr_Б24_СоответствиеЗадач.АйДиЗадачиБитрикс КАК АйДиЗадачи
		|ИЗ
		|	РегистрСведений.cbr_СтатусыЗадач.СрезПоследних(, Задача = &ЗадачаСсылка) КАК cbr_СтатусыЗадачСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.cbr_Б24_Настройки КАК cbr_Б24_Настройки
		|		ПО cbr_СтатусыЗадачСрезПоследних.Статус = cbr_Б24_Настройки.Настройка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.cbr_Б24_СоответствиеЗадач КАК cbr_Б24_СоответствиеЗадач
		|		ПО cbr_СтатусыЗадачСрезПоследних.Задача = cbr_Б24_СоответствиеЗадач.Задача";
	
	Запрос.УстановитьПараметр("ЗадачаСсылка", ЗадачаСсылка);
	Запрос.УстановитьПараметр("СтатусВБитриксеСтандартный", СтатусВБитриксеСтандартный);
	
	РезультатЗапроса = Запрос.Выполнить();
	Данные =  ОбменДаннымиСлужебный.РезультатЗапросаВСтруктуру(РезультатЗапроса);

	Ответ = OPI_Bitrix24.ИзменитьЗадачу(ДанныеАвторизации.БитриксURL, Данные.АйДиЗадачи, Данные, ДанныеАвторизации.Токен);
	
	Если Ответ["error"] <> Неопределено Тогда
		Возврат СоздатьСтруктуруРезультатаДействия(Ложь, Ответ["error_description"]);
	КонецЕсли;
	
	Возврат СоздатьСтруктуруРезультатаДействия(Истина);
	
КонецФункции

