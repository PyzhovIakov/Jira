	КонецЕсли;
	
	Возврат СоздатьСтруктуруРезультатаДействия(Истина);
	
КонецФункции

Функция ВернутьВышестоящуюЗадачуВРаботу(Знач ЗадачаСсылка, Знач ДанныеАвторизации) Экспорт

	ГлавнаяЗадача = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗадачаСсылка, "ГлавнаяЗадача");
	
	Ответ = СменитьСтатусЗадачи(ЗадачаСсылка, ДанныеАвторизации);
	Если НЕ Ответ.ДействиеВыполнено Тогда
		Возврат Ответ;
	КонецЕсли;
	
	Ответ = СменитьСтатусЗадачи(ГлавнаяЗадача, ДанныеАвторизации);
	Если НЕ Ответ.ДействиеВыполнено Тогда
		Возврат Ответ;
	КонецЕсли;
	
	Возврат СоздатьСтруктуруРезультатаДействия(Истина);
	
КонецФункции

Функция СменитьИсполнителяЗадачи(Знач ЗадачаСсылка, Знач ДанныеАвторизации) Экспорт
	
	СтатусВБитриксеСтандартный = 2;
	
	Запрос = Новый Запрос;
